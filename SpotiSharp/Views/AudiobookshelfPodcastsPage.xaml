<?xml version="1.0" encoding="utf-8"?>

<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:SpotiSharp.Views"
             xmlns:selectors="clr-namespace:SpotiSharp.Selectors"
             x:Class="SpotiSharp.Views.AudiobookshelfPodcastsPage"
                Title="Podcasts (AudioBookshelf)">
    <views:BasePage.Resources>
        <DataTemplate x:Key="GroupedTemplate">
            <views:AudiobookshelfShowGroupedListView />
        </DataTemplate>
        <DataTemplate x:Key="FlatTemplate">
            <views:AudiobookshelfRecentEpisodesFlatListView />
        </DataTemplate>
        <selectors:AudiobookshelfPodcastPageTemplateSelector x:Key="PageTemplateSelector"
                                                GroupedTemplate="{StaticResource GroupedTemplate}"
                                                FlatTemplate="{StaticResource FlatTemplate}" />
    </views:BasePage.Resources>
    <views:BasePage.Content>
        <Grid RowDefinitions="Auto,*">
            <!-- Filters out finished episodes on both swiped-to pages - on by default. -->
            <HorizontalStackLayout Grid.Row="0" Margin="8,6,8,2">
                <Button Text="Unplayed"
                        Command="{Binding ToggleUnplayedOnly}"
                        FontSize="13"
                        Padding="14,0"
                        CornerRadius="15"
                        HeightRequest="30"
                        BackgroundColor="{DynamicResource Gray900}"
                        TextColor="{DynamicResource TextSecondary}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding ShowUnplayedOnly}" Value="True">
                            <Setter Property="TextColor" Value="{DynamicResource Primary}" />
                            <Setter Property="FontAttributes" Value="Bold" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </HorizontalStackLayout>

            <CarouselView Grid.Row="1"
                          ItemsSource="{Binding Pages}"
                          ItemTemplate="{StaticResource PageTemplateSelector}"
                          Position="{Binding CurrentPageIndex, Mode=TwoWay}" />
        </Grid>
    </views:BasePage.Content>
</views:BasePage>
