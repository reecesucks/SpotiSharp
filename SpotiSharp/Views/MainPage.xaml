<?xml version="1.0" encoding="utf-8"?>

<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="using:SpotiSharp.Views"
                x:Class="SpotiSharp.MainPage"
                Title="Home">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ActivityIndicator Grid.Row="0" Grid.Column="0"
                           IsRunning="{Binding IsChecking}"
                           IsVisible="{Binding IsChecking}"
                           Color="{DynamicResource Primary}"
                           HeightRequest="48"
                           WidthRequest="48"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Margin="50,20,20,20">
            <Label FontSize="20" Margin="20,0,20,20" IsVisible="{Binding IsUserIsNotAuthenticated}" Text="You are not authenticated. To authenticate go to the ''Authentication'' page"/>

            <!-- Keypad test harness: use the phone's Up/Down keys to move the highlight.
                 Rows are built in code-behind (MainPage.xaml.cs). Remove once keypad input is proven. -->
            <Label Text="Keypad test — press Up / Down"
                   FontSize="16"
                   Margin="20,20,20,8"
                   TextColor="{DynamicResource TextSecondary}" />
            <VerticalStackLayout x:Name="KeypadTestList"
                                 Margin="20,0,20,0"
                                 Spacing="2" />
            <Label x:Name="KeypadStatusLabel"
                   FontSize="14"
                   Margin="20,12,20,0"
                   TextColor="{DynamicResource TextSecondary}"
                   Text="Last key: (none)" />
        </VerticalStackLayout>
    </Grid>
</views:BasePage>