<?xml version="1.0" encoding="utf-8"?>

<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:SpotiSharp.Views"
             xmlns:models="clr-namespace:SpotiSharp.Models"
             xmlns:viewmodels="clr-namespace:SpotiSharp.ViewModels"
             xmlns:converters="clr-namespace:SpotiSharp.Converters"
             xmlns:keypad="clr-namespace:SpotiSharp.Keypad"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             x:DataType="viewmodels:RadioPageViewModel"
             x:Name="RadioPageRoot"
             x:Class="SpotiSharp.Views.RadioPage"
                Title="Radio">
    <views:BasePage.Content>
        <Grid>
            <ActivityIndicator IsRunning="{Binding IsGenerating}"
                               IsVisible="{Binding IsGenerating}"
                               HeightRequest="32"
                               VerticalOptions="Start" />

            <keypad:KeypadCollectionView x:Name="MainListView" SelfManaged="False"
                            ItemsSource="{Binding Items}"
                            SelectedItem="{Binding SelectedItem}"
                            ActivateCommand="{Binding SelectItem}"
                            ItemSizingStrategy="MeasureFirstItem">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:RadioItem">
                        <!-- fixed height so every row is uniform and the list only measures once -->
                        <!-- tap and long press are wired natively in code behind: a maui
                             TapGestureRecognizer swallows the touch and blocks long press -->
                        <Grid ColumnDefinitions="Auto,*" Padding="8,6" HeightRequest="64"
                              HandlerChanged="OnRowHandlerChanged">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="Transparent" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <!-- Keypad focus highlight; "currently playing" uses the separate IsCurrent trigger below. -->
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="{DynamicResource SelectedRowBackground}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid.Triggers>
                                <DataTrigger TargetType="Grid" Binding="{Binding IsCurrent}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource Gray900}" />
                                </DataTrigger>
                            </Grid.Triggers>
                            <Image Grid.Column="0"
                                   Source="{Binding ImageUrl}"
                                   Aspect="AspectFill"
                                   HeightRequest="52"
                                   WidthRequest="52"
                                   IsVisible="{Binding IsConfirmingRemove, Converter={converters:BooleanConverter}}" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2" Margin="10,0,0,0" VerticalOptions="Center"
                                                 IsVisible="{Binding IsConfirmingRemove, Converter={converters:BooleanConverter}}">
                                <Label Text="{Binding Title}"
                                       FontSize="17"
                                       LineBreakMode="TailTruncation">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsCurrent}" Value="True">
                                            <Setter Property="TextColor" Value="{DynamicResource Primary}" />
                                            <Setter Property="FontAttributes" Value="Bold" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label Text="{Binding Subtitle}"
                                       FontSize="13"
                                       TextColor="{DynamicResource TextSecondary}"
                                       LineBreakMode="TailTruncation" />
                                <HorizontalStackLayout Spacing="3"
                                                       IsVisible="{Binding IsPodcastSegment}"
                                                       BindableLayout.ItemsSource="{Binding SegmentPips}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="sys:Boolean">
                                            <BoxView HeightRequest="4"
                                                     WidthRequest="26"
                                                     CornerRadius="2"
                                                     Color="{DynamicResource Gray600}">
                                                <BoxView.Triggers>
                                                    <DataTrigger TargetType="BoxView" Binding="{Binding .}" Value="True">
                                                        <Setter Property="Color" Value="{DynamicResource Primary}" />
                                                    </DataTrigger>
                                                </BoxView.Triggers>
                                            </BoxView>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <!-- revealed by a long press, replaces the row content -->
                            <Grid Grid.Column="0" Grid.ColumnSpan="2"
                                  ColumnDefinitions="*,*"
                                  ColumnSpacing="6"
                                  IsVisible="{Binding IsConfirmingRemove}">
                                <Border Grid.Column="0" Grid.ColumnSpan="2"
                                        BackgroundColor="{DynamicResource Danger}"
                                        StrokeShape="RoundRectangle 6"
                                        Stroke="Transparent"
                                        IsVisible="{Binding IsPodcastSegment, Converter={converters:BooleanConverter}}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding BindingContext.RemoveSingle, Source={x:Reference RadioPageRoot}}"
                                                               CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="Remove"
                                           FontSize="14"
                                           TextColor="{DynamicResource OnDanger}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                                <Border Grid.Column="0"
                                        BackgroundColor="{DynamicResource Danger}"
                                        StrokeShape="RoundRectangle 6"
                                        Stroke="Transparent"
                                        IsVisible="{Binding IsPodcastSegment}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding BindingContext.RemoveSingle, Source={x:Reference RadioPageRoot}}"
                                                               CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="Remove section"
                                           FontSize="12"
                                           TextColor="{DynamicResource OnDanger}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                                <Border Grid.Column="1"
                                        BackgroundColor="{DynamicResource Danger}"
                                        StrokeShape="RoundRectangle 6"
                                        Stroke="Transparent"
                                        IsVisible="{Binding IsPodcastSegment}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding BindingContext.RemoveAllSections, Source={x:Reference RadioPageRoot}}"
                                                               CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="Remove all sections"
                                           FontSize="12"
                                           TextColor="{DynamicResource OnDanger}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <Button Text="Add More"
                            Margin="8,12"
                            Command="{Binding GenerateMoreRadio}"
                            IsEnabled="{Binding IsGenerating, Converter={converters:BooleanConverter}}" />
                </CollectionView.Footer>
            </keypad:KeypadCollectionView>
        </Grid>
    </views:BasePage.Content>
</views:BasePage>
