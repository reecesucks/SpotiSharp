<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SpotiSharp.Models"
             xmlns:viewmodels="clr-namespace:SpotiSharp.ViewModels"
             xmlns:keypad="clr-namespace:SpotiSharp.Keypad"
             x:DataType="viewmodels:AlbumListViewModel"
             x:Class="SpotiSharp.Views.AlbumListView">
    <Grid>
    <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
    <keypad:KeypadCollectionView x:Name="MainListView"
              ItemsSource="{Binding Albums}"
              SelectedItem="{Binding SelectedAlbum}"
              ActivateCommand="{Binding OpenAlbumCommand}">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:Album">
                <Grid Margin="0,2,0,0" ColumnDefinitions="Auto,*" AutomationId="{Binding AlbumId}">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="Transparent" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Selected">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{DynamicResource SelectedRowBackground}" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Image Grid.Column="0"
                           Source="{Binding AlbumImageUrl}"
                           Aspect="AspectFill"
                           HeightRequest="60"
                           WidthRequest="60" />
                    <VerticalStackLayout Grid.Column="1" Margin="10,0,0,0" VerticalOptions="Center">
                        <Label FontSize="18"
                               LineBreakMode="TailTruncation"
                               Text="{Binding AlbumName}" />
                        <Label FontSize="14"
                               TextColor="{DynamicResource TextSecondary}"
                               LineBreakMode="TailTruncation"
                               Text="{Binding ArtistNames}" />
                    </VerticalStackLayout>
                </Grid>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </keypad:KeypadCollectionView>
    </RefreshView>

    <!-- Opaque cover shown while the list first populates, so the rows inflate under it
         instead of freezing the flyout as it slides closed. -->
    <Grid IsVisible="{Binding IsLoading}" BackgroundColor="{DynamicResource PageBackground}">
        <ActivityIndicator IsRunning="{Binding IsLoading}"
                           HeightRequest="40"
                           WidthRequest="40"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
    </Grid>
    </Grid>
</ContentView>
