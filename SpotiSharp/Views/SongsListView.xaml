<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SpotiSharp.Models"
             xmlns:viewmodels="clr-namespace:SpotiSharp.ViewModels"
             xmlns:keypad="clr-namespace:SpotiSharp.Keypad"
             x:DataType="viewmodels:SongsListViewModel"
             x:Class="SpotiSharp.SongsListView">
    <Grid>
    <ActivityIndicator IsRunning="{Binding IsLoading}"
                        IsVisible="{Binding IsLoading}"
                        HeightRequest="32"
                        VerticalOptions="Start" />
    <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
    <keypad:KeypadCollectionView x:Name="MainListView"
        ItemsSource="{Binding Songs}"
        ActivateCommand="{Binding PlaySongCommand}">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:Song">
                <Grid ColumnDefinitions="Auto,Auto" AutomationId="{Binding SongId}">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="Transparent" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Selected">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{DynamicResource SelectedRowBackground}" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Image Grid.Column="0"
                           x:Name="SongImage"
                           Source="{Binding SongImageURL}"
                           Aspect="AspectFill"
                           HeightRequest="60"
                           WidthRequest="60" />
                    <VerticalStackLayout Grid.Column="1" Spacing="0" Margin="10,0,0,0" VerticalOptions="Center">
                        <Label x:Name="SongName"
                               Text="{Binding SongTitle}" />
                        <Label x:Name="SongArtists"
                               Text="{Binding SongArtists}" />
                    </VerticalStackLayout>
                </Grid>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </keypad:KeypadCollectionView>
    </RefreshView>
    </Grid>
</ContentView>