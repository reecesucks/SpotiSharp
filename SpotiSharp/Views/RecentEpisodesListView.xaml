<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SpotiSharp.Models"
             xmlns:viewmodels="clr-namespace:SpotiSharp.ViewModels"
             xmlns:keypad="clr-namespace:SpotiSharp.Keypad"
             x:DataType="viewmodels:RecentEpisodesListViewModel"
             x:Class="SpotiSharp.Views.RecentEpisodesListView">
    <Grid>
    <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
    <keypad:KeypadCollectionView x:Name="GroupedList" SelfManaged="False"
                    ItemsSource="{Binding ShowGroups}"
                    ActivateCommand="{Binding ToggleGroupExpanded}">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="viewmodels:ShowGroupViewModel">
                <VerticalStackLayout>
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="Transparent" />
                                    <Setter TargetName="ShowNameLabel" Property="Label.TextColor" Value="{DynamicResource TextPrimary}" />
                                    <Setter TargetName="ChevronLabel" Property="Label.TextColor" Value="{DynamicResource TextPrimary}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Selected">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{DynamicResource SelectedRowBackground}" />
                                    <Setter TargetName="ShowNameLabel" Property="Label.TextColor" Value="{DynamicResource SelectedRowText}" />
                                    <Setter TargetName="ChevronLabel" Property="Label.TextColor" Value="{DynamicResource SelectedRowText}" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Grid Padding="8,8" ColumnDefinitions="56,*,Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleExpanded}" />
                        </Grid.GestureRecognizers>
                        <Image Grid.Column="0"
                               Source="{Binding ShowImageUrl}"
                               Aspect="AspectFill"
                               HeightRequest="56"
                               WidthRequest="56" />
                        <Label Grid.Column="1"
                               x:Name="ShowNameLabel"
                               Text="{Binding ShowName}"
                               FontSize="22"
                               Margin="10,0,0,0"
                               VerticalOptions="Center"
                               LineBreakMode="TailTruncation" />
                        <Label Grid.Column="2"
                               x:Name="ChevronLabel"
                               Text="▸"
                               FontSize="20"
                               VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsExpanded}" Value="True">
                                    <Setter Property="Text" Value="▾" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Grid>
                    <ActivityIndicator IsRunning="{Binding IsLoading}"
                                        IsVisible="{Binding IsLoading}"
                                        HeightRequest="32" />
                    <VerticalStackLayout IsVisible="{Binding IsExpanded}"
                                          BindableLayout.ItemsSource="{Binding Episodes}"
                                          Padding="16,0,8,8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:RecentEpisode">
                                <VerticalStackLayout Padding="0,6">
                                    <Label Text="{Binding EpisodeName}"
                                           FontSize="19"
                                           LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding ReleaseDate, StringFormat='{0:d}'}"
                                           FontSize="16"
                                           TextColor="{DynamicResource TextSecondary}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </keypad:KeypadCollectionView>
    </RefreshView>

    <!-- Opaque cover shown while the list first populates, so the rows inflate under it
         instead of freezing the flyout as it slides closed. -->
    <Grid IsVisible="{Binding IsLoading}" BackgroundColor="{DynamicResource PageBackground}">
        <ActivityIndicator IsRunning="{Binding IsLoading}"
                           HeightRequest="40"
                           WidthRequest="40"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
    </Grid>
    </Grid>
</ContentView>
