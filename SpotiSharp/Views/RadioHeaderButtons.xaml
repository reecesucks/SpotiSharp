<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:keypad="clr-namespace:SpotiSharp.Keypad"
             xmlns:viewmodels="clr-namespace:SpotiSharp.ViewModels"
             x:DataType="viewmodels:RadioPageViewModel"
             x:Class="SpotiSharp.Views.RadioHeaderButtons">
    <!-- Lives in the native title bar (see BasePage.CreateTitleAccessory), so its
         BindingContext comes from the page, not from being nested in page content. -->
    <keypad:KeypadButtonRow x:Name="HeaderRow" SelfManaged="False"
                             ColumnDefinitions="Auto,Auto" ColumnSpacing="6"
                             VerticalOptions="Center">
        <Button Grid.Column="0" Text="Generate" Command="{Binding GenerateRadio}"
                FontSize="12" Padding="10,0" CornerRadius="14" HeightRequest="30">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="KeypadStates">
                    <VisualState x:Name="Unfocused">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource Gray900}" />
                            <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource SelectedRowBackground}" />
                            <Setter Property="TextColor" Value="{DynamicResource SelectedRowText}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Button>
        <Button Grid.Column="1" Text="Settings" Command="{Binding OpenSettings}"
                FontSize="12" Padding="10,0" CornerRadius="14" HeightRequest="30">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="KeypadStates">
                    <VisualState x:Name="Unfocused">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource Gray900}" />
                            <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource SelectedRowBackground}" />
                            <Setter Property="TextColor" Value="{DynamicResource SelectedRowText}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Button>
    </keypad:KeypadButtonRow>
</ContentView>
